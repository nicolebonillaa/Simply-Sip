{
  "expo": {
    "name": "Simply Sip",
    "slug": "simplysip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/simply sip logo/simply-sip-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Simply Sip to use your location to show nearby drink spots."
        }
      ],
      "react-native-maps",
      [
        "expo-splash-screen",
        {
          "image": "./assets/simply sip logo/simply-sip-splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.simplysip"
    },
    "android": {
      "package": "com.anonymous.simplysip",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/simply sip logo/simply-sip-icon-android.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}